# Defaults: isolated demo, no credentials or external API requests.
ADAPTER_MODE=fake
SINGLE_USER_MODE=true
DATABASE_URL=sqlite:///./devbrief.db
PUBLIC_ORIGIN=http://localhost:5173
GHES_ALLOWED_ORGS=example-org
GHES_ALLOWED_REPOS=example-org/vision,example-org/platform,example-org/restricted
DATA_POLICY=metadata_only
REPORT_TIMEZONE=Asia/Seoul
# Real mode: use approved internal hosts and mounted secret files.
# APPROVED_EGRESS_HOSTS=github.internal.example,llm.internal.example
# GHES_BASE_URL=https://github.internal.example
# GHES_API_BASE_URL=https://github.internal.example/api/v3
# GHES_API_VERSION=2022-11-28
# GHES_CA_BUNDLE=/run/secrets/company-ca.pem
# GHES_PAT_FILE=/run/secrets/ghes_pat
# LLM_BASE_URL=https://llm.internal.example/v1
# LLM_MODEL=company-model
# LLM_API_KEY_FILE=/run/secrets/llm_api_key
# LLM_CA_BUNDLE=/run/secrets/company-ca.pem
# LLM_JSON_MODE=true
# Multi-user: signed proxy authentication, default-deny repo ACL.
# SINGLE_USER_MODE=false
# TRUSTED_PROXY_IPS=127.0.0.1
# PROXY_SECRET_FILE=/run/secrets/proxy_hmac
# ADMIN_PRINCIPALS=admin@example.com
# REPO_ACL_JSON={"alice@example.com":["example-org/vision"]}
RETENTION_DAYS=90
